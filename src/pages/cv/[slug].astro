---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const entries = await getCollection('cv', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Base title={`${entry.data.role} at ${entry.data.organisation} | Ieva Rozentale`}>
  <!-- CV entry detail page. Not in nav — shareable URL only. Styled in next phase. -->
  <main>
    <h1>{entry.data.role}</h1>
    <p>{entry.data.organisation} · {entry.data.period}</p>
    <Content />
  </main>
</Base>
