---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CollageCluster from '../components/CollageCluster.astro';
import DoorCard from '../components/DoorCard.astro';

// Hero collage — CSS-variant fragments (responsive overrides live in global.css).
const heroFragments = [
  { cssVariant: 'cut1'         as const },
  { cssVariant: 'cut2'         as const },
  { cssVariant: 'accent-clay'  as const },
  { cssVariant: 'accent-royal' as const },
];

// About-aside collage — custom inline-positioned fragments.
const aboutFragments = [
  {
    // torn paper card — the backing
    right: '0', top: '10px', width: '150px', height: '118px',
    rotation: -3,
    clipPath: 'polygon(0 4%, 97% 0, 100% 94%, 3% 100%)',
    background: '#fbf7ee',
  },
  {
    // photo placeholder — sits on top of the card
    right: '18px', top: '24px', width: '120px', height: '92px',
    rotation: -3,
    clipPath: 'polygon(4% 6%, 72% 0, 100% 24%, 94% 74%, 72% 100%, 24% 94%, 0 58%)',
    background: [
      'radial-gradient(circle at 40% 32%, rgba(245,239,227,.85) 0 5%, rgba(245,239,227,0) 6%)',
      'linear-gradient(180deg, #c9bfa9 0 52%, #8c8168 52% 100%)',
    ].join(','),
  },
];
---

<Base
  title="Ieva Rozentale — Facilitation, Research & Reflective Practice"
  description="Facilitation consultant based in NSW, Australia. Workshops, scenario planning, collaborative problem-solving, and guided meditations."
>
  <Header currentPath="/" />

  <main>

    <!-- ===== HERO ===== -->
    <section class="hero">
      <div class="wrap hero-grid">

        <CollageCluster
          height="330px"
          fragments={heroFragments}
          annotation={{ text: 'thinking, together & alone' }}
          class="reveal"
        />

        <div class="hero-text">
          <div class="eyebrow">Central Coast, NSW &mdash; &amp; online, worldwide</div>
          <h1>Creating spaces and opportunities for <em>insight and connection.</em></h1>
          <p class="lead">I design and facilitate collaborative processes for organisations, and teach reflective practices for everyday life.</p>
        </div>

      </div>
    </section>

    <!-- ===== DOORS ===== -->
    <section class="doors" aria-labelledby="doors-heading">
      <div class="wrap">
        <div class="sec-head reveal">
          <h2 id="doors-heading">Where would you like to begin?</h2>
          <span class="note hand" aria-hidden="true">pick a door</span>
        </div>
        <div class="door-grid">
          <DoorCard
            wing="professional"
            href="/facilitation/"
            heading="Facilitation"
            body="Workshops and collaborative processes that help groups explore complex challenges and move forward together."
          />
          <DoorCard
            wing="professional"
            href="/research-strategy/"
            heading="Research & Strategy"
            body="Understanding a problem deeply before solving it — qualitative research, behavioural insight, and strategy."
          />
          <DoorCard
            wing="meditation"
            href="/meditation/"
            heading="Meditation"
            body="Guided practices, events, and short courses — including a series of meditations for new parents."
          />
        </div>
      </div>
    </section>

    <!-- ===== ABOUT ===== -->
    <section class="about" aria-labelledby="about-heading">
      <div class="wrap about-grid">

        <div class="reveal">
          <div class="eyebrow">About</div>
          <h2 id="about-heading">Facilitator, researcher, and meditation teacher.</h2>
          <p>I work with organisations across Australia and internationally, in person and online, helping people explore problems together and move toward thoughtful action — and I make quiet space for reflection in between.</p>
          <div class="links">
            <a href="/about/">More about me</a>
            <a href="/cv/">CV</a>
          </div>
        </div>

        <div class="about-aside reveal" aria-hidden="true">
          <!-- Torn card + photo placeholder -->
          <div class="torn2"></div>
          <div class="photo-card"></div>
          <div class="annot2 hand">between forest &amp; ocean</div>
        </div>

      </div>
    </section>

    <!-- ===== CONTACT ===== -->
    <section class="contact" id="contact" aria-labelledby="contact-heading">
      <div class="wrap contact-grid">

        <div class="reveal">
          <div class="eyebrow">Contact</div>
          <h2 id="contact-heading">Start a conversation</h2>
          <p class="intro">Tell me a little about what you&rsquo;re working on, and how I might be able to help.</p>
          <div class="deets">
            <div><a href="mailto:ie.rozentale@gmail.com">ie.rozentale@gmail.com</a></div>
            <div><a href="https://www.linkedin.com/in/ieva-rozentale-83446739/" target="_blank" rel="noopener">linkedin.com/in/ieva-rozentale</a></div>
            <div>Central Coast, NSW, Australia</div>
          </div>
        </div>

        <div class="reveal">
          <!--
            Netlify Forms: the `data-netlify` attribute is detected at build time.
            The hidden form-name input is required for the fetch-based submission.
            The bot-field honeypot is hidden via CSS (.bot-field { display:none }).
            Note: form submission only works on the deployed Netlify site, not local dev.
          -->
          <form
            class="form"
            id="contact-form"
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            action="/#contact"
            novalidate
          >
            <input type="hidden" name="form-name" value="contact" />
            <p class="bot-field">
              <label>Don&rsquo;t fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
            </p>

            <div class="field">
              <label for="contact-name">Name</label>
              <input id="contact-name" type="text" name="name" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="contact-email">Email</label>
              <input id="contact-email" type="email" name="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="contact-message">Message</label>
              <textarea id="contact-message" name="message" required></textarea>
            </div>
            <button type="submit">Send message</button>
          </form>

          <div class="form-success" id="form-success" role="status" aria-live="polite">
            <strong>Thank you.</strong> I&rsquo;ll be in touch soon.
          </div>
        </div>

      </div>
    </section>

  </main>

  <Footer />

</Base>

<!-- Scroll-reveal: IntersectionObserver with prefers-reduced-motion guard -->
<script>
  (function () {
    const prefersReduced =
      window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const items = document.querySelectorAll<HTMLElement>('.reveal');

    if (prefersReduced || !('IntersectionObserver' in window)) {
      items.forEach((el) => el.classList.add('in'));
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          if (en.isIntersecting) {
            en.target.classList.add('in');
            io.unobserve(en.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    items.forEach((el) => io.observe(el));
  })();
</script>

<!-- Netlify Forms: intercept submit, use fetch, show in-page success state -->
<script>
  (function () {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const success = document.getElementById('form-success');
    if (!form || !success) return;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      const data = new FormData(form);

      fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(data as unknown as Record<string, string>).toString(),
      })
        .then(() => {
          form.style.display = 'none';
          success.classList.add('is-visible');
        })
        .catch(() => {
          // Fallback: let the browser submit normally (Netlify redirects to /thanks).
          form.submit();
        });
    });
  })();
</script>
