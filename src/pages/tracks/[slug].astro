---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const entries = await getCollection('tracks', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Base title={`${entry.data.title} | Ieva Rozentale`} description={entry.data.description}>
  <!-- Meditation track detail page. Not in nav — shareable URL only. Styled in next phase. -->
  <main>
    <h1>{entry.data.title}</h1>
    {entry.data.duration && <p>Duration: {entry.data.duration}</p>}
    {entry.data.audioUrl && <audio controls src={entry.data.audioUrl}></audio>}
    <Content />
  </main>
</Base>
